{
  "info": {
    "_postman_id": "4d14ad7e-9652-4c74-b253-22a0cc3796e0",
    "name": "Open Charge Map API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "26382226"
  },
  "item": [
    {
      "name": "Get POIs",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. Status Code Validation",
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// 2. Response Time Validation",
              "pm.test(\"Response time is under 1000ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);",
              "});",
              "",
              "// 3. Schema & Business Logic Validation",
              "pm.test(\"Response is a valid array and respects maxresults\", function () {",
              "    var jsonData = pm.response.json();",
              "    ",
              "    // Schema Check: Must be an array",
              "    pm.expect(jsonData).to.be.an('array');",
              "    ",
              "    // Business Logic Check: Must not exceed maxresults limit",
              "    pm.expect(jsonData.length).to.be.at.most(3);",
              "    ",
              "    // Schema Structural Check: If data returns, check core keys",
              "    if (jsonData.length > 0) {",
              "        var firstPoi = jsonData[0];",
              "        pm.expect(firstPoi).to.have.property('ID');",
              "        pm.expect(firstPoi).to.have.property('AddressInfo');",
              "        pm.expect(firstPoi.AddressInfo).to.have.property('Latitude');",
              "        pm.expect(firstPoi.AddressInfo).to.have.property('Longitude');",
              "    }",
              "});",
              "",
              "// Visualization Script",
              "",
              "const template = `",
              "<style>",
              "  body {",
              "    font-family: 'Segoe UI', Arial, sans-serif;",
              "    margin: 16px;",
              "    background: #f4f6f9;",
              "    color: #333;",
              "  }",
              "  h2 {",
              "    color: #2c3e50;",
              "    margin-bottom: 12px;",
              "    font-size: 18px;",
              "  }",
              "  table {",
              "    width: 100%;",
              "    border-collapse: collapse;",
              "    background: #fff;",
              "    border-radius: 8px;",
              "    overflow: hidden;",
              "    box-shadow: 0 2px 8px rgba(0,0,0,0.1);",
              "  }",
              "  thead tr {",
              "    background: #2c3e50;",
              "    color: #fff;",
              "  }",
              "  thead th {",
              "    padding: 12px 14px;",
              "    text-align: left;",
              "    font-size: 13px;",
              "    font-weight: 600;",
              "    letter-spacing: 0.4px;",
              "    white-space: nowrap;",
              "  }",
              "  tbody tr:nth-child(even) {",
              "    background: #f0f4f8;",
              "  }",
              "  tbody tr:nth-child(odd) {",
              "    background: #ffffff;",
              "  }",
              "  tbody tr:hover {",
              "    background: #dce8f5;",
              "  }",
              "  tbody td {",
              "    padding: 10px 14px;",
              "    font-size: 13px;",
              "    vertical-align: top;",
              "    border-bottom: 1px solid #e2e8f0;",
              "  }",
              "  .badge {",
              "    display: inline-block;",
              "    padding: 2px 8px;",
              "    border-radius: 12px;",
              "    font-size: 11px;",
              "    font-weight: 600;",
              "    background: #e8f5e9;",
              "    color: #2e7d32;",
              "  }",
              "  .badge-unknown {",
              "    background: #f5f5f5;",
              "    color: #9e9e9e;",
              "  }",
              "  .points {",
              "    font-weight: 700;",
              "    color: #1565c0;",
              "  }",
              "  .no-data {",
              "    color: #aaa;",
              "    font-style: italic;",
              "  }",
              "</style>",
              "<h2>EV Charging Stations ({{count}} POIs)</h2>",
              "<table>",
              "  <thead>",
              "    <tr>",
              "      <th>#</th>",
              "      <th>Name</th>",
              "      <th>Address</th>",
              "      <th>Operator</th>",
              "      <th>Usage Type</th>",
              "      <th>Connections</th>",
              "      <th>Power (kW)</th>",
              "      <th>Status</th>",
              "      <th>Points</th>",
              "    </tr>",
              "  </thead>",
              "  <tbody>",
              "    {{#each stations}}",
              "    <tr>",
              "      <td>{{index}}</td>",
              "      <td><strong>{{name}}</strong></td>",
              "      <td>{{address}}</td>",
              "      <td>{{operator}}</td>",
              "      <td>{{usageType}}</td>",
              "      <td>{{connections}}</td>",
              "      <td>{{power}}</td>",
              "      <td><span class=\"badge {{statusClass}}\">{{status}}</span></td>",
              "      <td><span class=\"points\">{{points}}</span></td>",
              "    </tr>",
              "    {{/each}}",
              "  </tbody>",
              "</table>",
              "`;",
              "",
              "function createPayload() {",
              "  var data = pm.response.json();",
              "  var stations = data.map(function(poi, idx) {",
              "    var addr = poi.AddressInfo || {};",
              "    var addressParts = [addr.AddressLine1, addr.Town].filter(function(p) { return p; });",
              "    var connections = '-';",
              "    var power = '-';",
              "    if (poi.Connections && poi.Connections.length > 0) {",
              "      connections = poi.Connections.map(function(c) {",
              "        return (c.ConnectionType && c.ConnectionType.Title) ? c.ConnectionType.Title : '-';",
              "      }).join(', ');",
              "      var powers = poi.Connections.map(function(c) {",
              "        return c.PowerKW != null ? c.PowerKW : null;",
              "      }).filter(function(p) { return p !== null; });",
              "      power = powers.length > 0 ? powers.join(', ') : '-';",
              "    }",
              "    var status = (poi.StatusType && poi.StatusType.Title) ? poi.StatusType.Title : '-';",
              "    return {",
              "      index: idx + 1,",
              "      name: addr.Title || '-',",
              "      address: addressParts.length > 0 ? addressParts.join(', ') : '-',",
              "      operator: (poi.OperatorInfo && poi.OperatorInfo.Title) ? poi.OperatorInfo.Title : '-',",
              "      usageType: (poi.UsageType && poi.UsageType.Title) ? poi.UsageType.Title : '-',",
              "      connections: connections,",
              "      power: power,",
              "      status: status,",
              "      statusClass: status === '-' ? 'badge-unknown' : '',",
              "      points: poi.NumberOfPoints != null ? poi.NumberOfPoints : '-'",
              "    };",
              "  });",
              "  return { stations: stations, count: stations.length };",
              "}",
              "",
              "pm.visualizer.set(template, createPayload());",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/poi/?key={{apiKey}}&latitude=-34.6037&longitude=-58.3816&distance=10&countrycode=AR&maxresults=3",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "poi",
            ""
          ],
          "query": [
            {
              "key": "key",
              "value": "{{apiKey}}"
            },
            {
              "key": "latitude",
              "value": "-34.6037"
            },
            {
              "key": "longitude",
              "value": "-58.3816"
            },
            {
              "key": "distance",
              "value": "10"
            },
            {
              "key": "countrycode",
              "value": "AR"
            },
            {
              "key": "maxresults",
              "value": "3"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get referencedata",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. Status Code Validation",
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// 2. Response Time Validation",
              "pm.test(\"Response time is under 1000ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);",
              "});",
              "",
              "// 3. Schema & Business Logic Validation",
              "pm.test(\"Response is a valid reference data object\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('object');",
              "    pm.expect(jsonData).to.have.property('ChargerTypes');",
              "    pm.expect(jsonData).to.have.property('ConnectionTypes');",
              "    pm.expect(jsonData).to.have.property('Countries');",
              "    pm.expect(jsonData).to.have.property('StatusTypes');",
              "    pm.expect(jsonData.ChargerTypes).to.be.an('array');",
              "    pm.expect(jsonData.ChargerTypes.length).to.be.above(0);",
              "    var firstCharger = jsonData.ChargerTypes[0];",
              "    pm.expect(firstCharger).to.have.property('ID');",
              "    pm.expect(firstCharger).to.have.property('Title');",
              "});",
              "",
              "// Visualization Script",
              "",
              "const template = `",
              "<style>",
              "  * { box-sizing: border-box; margin: 0; padding: 0; }",
              "  body {",
              "    font-family: 'Segoe UI', Arial, sans-serif;",
              "    background: #f0f2f5;",
              "    padding: 16px;",
              "    color: #333;",
              "  }",
              "  h1 {",
              "    font-size: 18px;",
              "    color: #2c3e50;",
              "    margin-bottom: 16px;",
              "    border-left: 4px solid #3498db;",
              "    padding-left: 10px;",
              "  }",
              "  .section {",
              "    background: #fff;",
              "    border-radius: 8px;",
              "    box-shadow: 0 2px 8px rgba(0,0,0,0.08);",
              "    margin-bottom: 20px;",
              "    overflow: hidden;",
              "  }",
              "  .section-header {",
              "    background: #2c3e50;",
              "    color: #fff;",
              "    padding: 10px 16px;",
              "    display: flex;",
              "    align-items: center;",
              "    justify-content: space-between;",
              "  }",
              "  .section-header h2 {",
              "    font-size: 14px;",
              "    font-weight: 600;",
              "  }",
              "  .badge {",
              "    background: #3498db;",
              "    color: #fff;",
              "    border-radius: 12px;",
              "    padding: 2px 10px;",
              "    font-size: 11px;",
              "    font-weight: 700;",
              "  }",
              "  table {",
              "    width: 100%;",
              "    border-collapse: collapse;",
              "    font-size: 12px;",
              "  }",
              "  th {",
              "    background: #ecf0f1;",
              "    color: #555;",
              "    text-align: left;",
              "    padding: 7px 12px;",
              "    font-weight: 600;",
              "    border-bottom: 1px solid #ddd;",
              "  }",
              "  td {",
              "    padding: 6px 12px;",
              "    border-bottom: 1px solid #f0f0f0;",
              "    vertical-align: middle;",
              "  }",
              "  tr:last-child td { border-bottom: none; }",
              "  tr:hover td { background: #f9fbfd; }",
              "  .pill {",
              "    display: inline-block;",
              "    border-radius: 10px;",
              "    padding: 1px 8px;",
              "    font-size: 10px;",
              "    font-weight: 600;",
              "    margin: 1px;",
              "  }",
              "  .pill-green  { background: #d4edda; color: #155724; }",
              "  .pill-red    { background: #f8d7da; color: #721c24; }",
              "  .pill-grey   { background: #e2e3e5; color: #383d41; }",
              "  .pill-blue   { background: #cce5ff; color: #004085; }",
              "  .pill-orange { background: #fff3cd; color: #856404; }",
              "  .more-row td {",
              "    text-align: center;",
              "    color: #888;",
              "    font-style: italic;",
              "    padding: 6px;",
              "    background: #fafafa;",
              "  }",
              "</style>",
              "",
              "<h1>Open Charge Map - Reference Data</h1>",
              "",
              "{{#if connectionTypes}}",
              "<div class=\"section\">",
              "  <div class=\"section-header\">",
              "    <h2>Connection Types</h2>",
              "    <span class=\"badge\">{{connectionTypes.total}}</span>",
              "  </div>",
              "  <table>",
              "    <thead><tr><th>ID</th><th>Title</th><th>Formal Name</th><th>Status</th></tr></thead>",
              "    <tbody>",
              "      {{#each connectionTypes.items}}",
              "      <tr>",
              "        <td>{{ID}}</td>",
              "        <td>{{Title}}</td>",
              "        <td>{{#if FormalName}}{{FormalName}}{{else}}<span style=\"color:#aaa\">-</span>{{/if}}</td>",
              "        <td>",
              "          {{#if IsObsolete}}<span class=\"pill pill-red\">Obsolete</span>{{/if}}",
              "          {{#if IsDiscontinued}}<span class=\"pill pill-orange\">Discontinued</span>{{/if}}",
              "          {{#unless IsObsolete}}{{#unless IsDiscontinued}}<span class=\"pill pill-green\">Active</span>{{/unless}}{{/unless}}",
              "        </td>",
              "      </tr>",
              "      {{/each}}",
              "      {{#if connectionTypes.hasMore}}<tr class=\"more-row\"><td colspan=\"4\">... and {{connectionTypes.remaining}} more</td></tr>{{/if}}",
              "    </tbody>",
              "  </table>",
              "</div>",
              "{{/if}}",
              "",
              "{{#if countries}}",
              "<div class=\"section\">",
              "  <div class=\"section-header\">",
              "    <h2>Countries</h2>",
              "    <span class=\"badge\">{{countries.total}}</span>",
              "  </div>",
              "  <table>",
              "    <thead><tr><th>ID</th><th>Title</th><th>ISO Code</th><th>Continent</th></tr></thead>",
              "    <tbody>",
              "      {{#each countries.items}}",
              "      <tr>",
              "        <td>{{ID}}</td>",
              "        <td>{{Title}}</td>",
              "        <td><span class=\"pill pill-blue\">{{ISOCode}}</span></td>",
              "        <td>{{#if ContinentCode}}<span class=\"pill pill-grey\">{{ContinentCode}}</span>{{else}}<span style=\"color:#aaa\">-</span>{{/if}}</td>",
              "      </tr>",
              "      {{/each}}",
              "      {{#if countries.hasMore}}<tr class=\"more-row\"><td colspan=\"4\">... and {{countries.remaining}} more</td></tr>{{/if}}",
              "    </tbody>",
              "  </table>",
              "</div>",
              "{{/if}}",
              "",
              "{{#if statusTypes}}",
              "<div class=\"section\">",
              "  <div class=\"section-header\">",
              "    <h2>Status Types</h2>",
              "    <span class=\"badge\">{{statusTypes.total}}</span>",
              "  </div>",
              "  <table>",
              "    <thead><tr><th>ID</th><th>Title</th><th>Operational</th></tr></thead>",
              "    <tbody>",
              "      {{#each statusTypes.items}}",
              "      <tr>",
              "        <td>{{ID}}</td>",
              "        <td>{{Title}}</td>",
              "        <td>",
              "          {{#if IsOperational}}<span class=\"pill pill-green\">Yes</span>",
              "          {{else}}{{#if IsOperationalNull}}<span class=\"pill pill-grey\">Unknown</span>",
              "          {{else}}<span class=\"pill pill-red\">No</span>{{/if}}{{/if}}",
              "        </td>",
              "      </tr>",
              "      {{/each}}",
              "      {{#if statusTypes.hasMore}}<tr class=\"more-row\"><td colspan=\"3\">... and {{statusTypes.remaining}} more</td></tr>{{/if}}",
              "    </tbody>",
              "  </table>",
              "</div>",
              "{{/if}}",
              "",
              "{{#if chargerTypes}}",
              "<div class=\"section\">",
              "  <div class=\"section-header\">",
              "    <h2>Charger Types</h2>",
              "    <span class=\"badge\">{{chargerTypes.total}}</span>",
              "  </div>",
              "  <table>",
              "    <thead><tr><th>ID</th><th>Title</th><th>Fast Charge</th><th>Comments</th></tr></thead>",
              "    <tbody>",
              "      {{#each chargerTypes.items}}",
              "      <tr>",
              "        <td>{{ID}}</td>",
              "        <td>{{Title}}</td>",
              "        <td>{{#if IsFastChargeCapable}}<span class=\"pill pill-green\">Yes</span>{{else}}<span class=\"pill pill-grey\">No</span>{{/if}}</td>",
              "        <td>{{#if Comments}}{{Comments}}{{else}}<span style=\"color:#aaa\">-</span>{{/if}}</td>",
              "      </tr>",
              "      {{/each}}",
              "    </tbody>",
              "  </table>",
              "</div>",
              "{{/if}}",
              "",
              "{{#if currentTypes}}",
              "<div class=\"section\">",
              "  <div class=\"section-header\">",
              "    <h2>Current Types</h2>",
              "    <span class=\"badge\">{{currentTypes.total}}</span>",
              "  </div>",
              "  <table>",
              "    <thead><tr><th>ID</th><th>Title</th><th>Description</th></tr></thead>",
              "    <tbody>",
              "      {{#each currentTypes.items}}",
              "      <tr>",
              "        <td>{{ID}}</td>",
              "        <td>{{Title}}</td>",
              "        <td>{{#if Description}}{{Description}}{{else}}<span style=\"color:#aaa\">-</span>{{/if}}</td>",
              "      </tr>",
              "      {{/each}}",
              "    </tbody>",
              "  </table>",
              "</div>",
              "{{/if}}",
              "`;",
              "",
              "function buildPayload() {",
              "    var data = pm.response.json();",
              "    var MAX = 15;",
              "",
              "    function sliceCategory(arr) {",
              "        return {",
              "            total: arr.length,",
              "            items: arr.slice(0, MAX),",
              "            hasMore: arr.length > MAX,",
              "            remaining: arr.length - MAX",
              "        };",
              "    }",
              "",
              "    var payload = {};",
              "",
              "    if (Array.isArray(data.ConnectionTypes) && data.ConnectionTypes.length > 0) {",
              "        var ct = sliceCategory(data.ConnectionTypes);",
              "        ct.items = ct.items.map(function(item) {",
              "            return {",
              "                ID: item.ID,",
              "                Title: item.Title,",
              "                FormalName: item.FormalName || null,",
              "                IsDiscontinued: item.IsDiscontinued === true,",
              "                IsObsolete: item.IsObsolete === true",
              "            };",
              "        });",
              "        payload.connectionTypes = ct;",
              "    }",
              "",
              "    if (Array.isArray(data.Countries) && data.Countries.length > 0) {",
              "        var co = sliceCategory(data.Countries);",
              "        co.items = co.items.map(function(item) {",
              "            return {",
              "                ID: item.ID,",
              "                Title: item.Title,",
              "                ISOCode: item.ISOCode,",
              "                ContinentCode: item.ContinentCode || null",
              "            };",
              "        });",
              "        payload.countries = co;",
              "    }",
              "",
              "    if (Array.isArray(data.StatusTypes) && data.StatusTypes.length > 0) {",
              "        var st = sliceCategory(data.StatusTypes);",
              "        st.items = st.items.map(function(item) {",
              "            return {",
              "                ID: item.ID,",
              "                Title: item.Title,",
              "                IsOperational: item.IsOperational === true,",
              "                IsOperationalNull: item.IsOperational === null || item.IsOperational === undefined",
              "            };",
              "        });",
              "        payload.statusTypes = st;",
              "    }",
              "",
              "    if (Array.isArray(data.ChargerTypes) && data.ChargerTypes.length > 0) {",
              "        var ch = sliceCategory(data.ChargerTypes);",
              "        ch.items = ch.items.map(function(item) {",
              "            return {",
              "                ID: item.ID,",
              "                Title: item.Title,",
              "                IsFastChargeCapable: item.IsFastChargeCapable === true,",
              "                Comments: item.Comments || null",
              "            };",
              "        });",
              "        payload.chargerTypes = ch;",
              "    }",
              "",
              "    if (Array.isArray(data.CurrentTypes) && data.CurrentTypes.length > 0) {",
              "        var cur = sliceCategory(data.CurrentTypes);",
              "        cur.items = cur.items.map(function(item) {",
              "            return {",
              "                ID: item.ID,",
              "                Title: item.Title,",
              "                Description: item.Description || null",
              "            };",
              "        });",
              "        payload.currentTypes = cur;",
              "    }",
              "",
              "    return payload;",
              "}",
              "",
              "pm.visualizer.set(template, buildPayload());"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/referencedata/?key={{apiKey}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "referencedata",
            ""
          ],
          "query": [
            {
              "key": "key",
              "value": "{{apiKey}}"
            }
          ]
        }
      },
      "response": []
    }
